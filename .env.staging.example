# Staging env for docker-compose.staging.yml (the Caddy edge + static frontend).
# Copy to .env.staging ON THE VPS and fill in. The *.example is committed; the
# real .env.staging is git-ignored and lives only at
# $STAGING_VPS_PATH/web/.env.staging.
#
# Usage on the VPS:
#   cp .env.staging.example .env.staging
#   docker compose -f docker-compose.staging.yml --env-file .env.staging up -d --no-build

# ── Public domain (must have an A record pointing at this VPS for ACME) ─────────
STAGING_DOMAIN=dicomviewermed.online

# Email for Let's Encrypt certificate notices.
ACME_EMAIL=you@example.com

# ── Image (set by the deploy pipeline; override to pin/rollback a SHA tag) ──────
# WEB_IMAGE=ghcr.io/uba-micd/micd_web:staging

# ── Resource limits (4 GB VPS — see docs/staging-deployment/plan.md §2) ─────────
CADDY_MEM_LIMIT=64M
CADDY_MEM_RESERVE=32M
WEB_MEM_LIMIT=48M
WEB_MEM_RESERVE=16M

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3
