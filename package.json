{
  "name": "micd-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:html": "node scripts/build-html.mjs",
    "prebuild": "node scripts/build-html.mjs",
    "build": "tsc -p tsconfig.json",
    "test": "NODE_OPTIONS='--require=./src/test-preload.cjs' tsx --test 'src/**/*.test.ts'",
    "test:unit": "NODE_OPTIONS='--require=./src/test-preload.cjs' tsx --test 'src/viewer/*.test.ts'",
    "test:coverage": "mkdir -p coverage && NODE_OPTIONS='--require=./src/test-preload.cjs' tsx --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=coverage/lcov.info 'src/**/*.test.ts'",
    "check:anon-coverage": "node scripts/check-anon-coverage.mjs"
  },
  "dependencies": {
    "dicom-parser": "^1.8.21",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.3.3"
  }
}
