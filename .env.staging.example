# Staging env for docker-compose.staging.yml (the Caddy edge + static frontend).
# Copy to .env.staging ON THE VPS and fill in. The *.example is committed; the
# real .env.staging is git-ignored and lives only at
# $STAGING_VPS_PATH/web/.env.staging.
#
# Usage on the VPS:
#   cp .env.staging.example .env.staging
#   docker compose -f docker-compose.staging.yml --env-file .env.staging up -d --no-build

# ── Public domain (must have an A record pointing at this VPS for ACME) ─────────
STAGING_DOMAIN=dicomviewermed.online

# Email for Let's Encrypt certificate notices.
ACME_EMAIL=you@example.com

# ── Anonymizer ────────────────────────────────────────────────────────────────
# Where the staging viewer sends each DICOM to be anonymized before upload.
# /anonymizer is same-origin: caddy routes it to the anonymizer container
# (UBA-MICD/Anonymizer, deployed to $STAGING_VPS_PATH/anonymizer), so the CSP
# ('self') allows it and no CORS is needed. Staging is for TEST data only —
# the raw file reaches the VPS before it is anonymized.
# A user can still override it per browser with localStorage
# `micd_anonymizer_url` (e.g. http://127.0.0.1:8000 for a local service).
MICD_ANONYMIZER_URL=/anonymizer

# Max upload size caddy accepts on /anonymizer/* (the service holds each
# request in memory, capped at ANONYMIZER_MEM_LIMIT in its own stack).
ANONYMIZER_MAX_BODY=200MB

# ── Image (set by the deploy pipeline; override to pin/rollback a SHA tag) ──────
# WEB_IMAGE=ghcr.io/uba-micd/micd_web:staging

# ── Resource limits (4 GB VPS — see docs/staging-deployment/plan.md §2) ─────────
CADDY_MEM_LIMIT=64M
CADDY_MEM_RESERVE=32M
WEB_MEM_LIMIT=48M
WEB_MEM_RESERVE=16M

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3
