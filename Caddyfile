# Caddy edge for staging — the ONLY public entrypoint.
#
# Terminates HTTPS (automatic Let's Encrypt for $STAGING_DOMAIN, auto-renew) and
# routes: API/auth paths to the backend, /anonymizer/* to the staging
# anonymizer, everything else to the static frontend.
# HTTP:80 -> HTTPS is automatic in Caddy. See docs/staging-deployment/plan.md §1.
#
# $STAGING_DOMAIN and $ACME_EMAIL are provided from .env.staging at run time.
{
	email {$ACME_EMAIL}
}

{$STAGING_DOMAIN} {
	encode zstd gzip

	# API and auth calls -> backend (reached by service name over the `micd` network).
	# Static assets under /auth/* (e.g. /auth/session-ui.js, built from src/auth/)
	# must NOT be proxied to the backend — they are served by the SPA. nginx handles
	# this implicitly (regex .js/.css location outranks the /auth/ prefix); Caddy
	# needs it spelled out, else the frontend's /auth/*.js 404s from the backend.
	@api {
		path /api/* /auth/*
		not path *.js *.css *.map *.woff *.woff2 *.ttf *.svg *.png *.jpg *.jpeg *.gif *.ico
	}
	handle @api {
		reverse_proxy backend:3000
	}

	# DICOM anonymizer (UBA-MICD/Anonymizer) — STAGING ONLY, test data only.
	# In real use it runs on each workstation at 127.0.0.1:8000 (US-16); on
	# staging the viewer calls it same-origin at /anonymizer (MICD_ANONYMIZER_URL
	# in .env.staging). handle_path strips the prefix, so the service keeps its
	# own routes (GET /, POST /anonymize/). Unauthenticated, so cap the body:
	# the service reads every upload fully into memory.
	redir /anonymizer /anonymizer/ 308
	handle_path /anonymizer/* {
		request_body {
			max_size {$ANONYMIZER_MAX_BODY:200MB}
		}
		reverse_proxy anonymizer:8000
	}

	# Everything else -> the static SPA (nginx).
	handle {
		reverse_proxy web:80
	}
}
